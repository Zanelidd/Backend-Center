generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String
  cards    Card[]

  @@map("users")
}

model Card {
  id       Int    @id @default(autoincrement())
  remoteId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int

  @@unique([remoteId, userId])
  @@map("cards")
}

model PendingRegistration {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  username  String
  email     String
  hashPass  String
  expiresAt DateTime

  @@map("pending_registrations")
}
